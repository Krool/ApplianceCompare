# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Node — node_modules is regenerated from package-lock.json on npm install.
# package-lock.json IS committed so installs are reproducible.
node_modules/
.npm/

# Python (local dev server cache)
__pycache__/
*.pyc

# Local dev / scratch
*.log
.env
.env.local
.cache/

# Build output. GitHub Actions (pages.yml) builds and deploys dist/; it is
# never committed. docs/ was the old committed output; keep it out too.
dist/
docs/
build/

# Claude Code session state (user-local)
.claude/

# Local image-audit scratch (absolute paths, regenerated on demand)
.image-audit/

# optimize-images.mjs output: originals it replaced, pending a reviewed git rm
scripts/.optimize-orphans.txt
